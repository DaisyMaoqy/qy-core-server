// ============================================================
// auth_db —— 认证 / 用户身份库（独立库，只存账号密码与用户-租户归属）
// 逻辑外键：SysUserTenant.tenantId(String) 指向 ws_design_db.SysTenant.tenantId
//          （不建 DB 级 FK，跨库关联；租户展示字段在 SysUserTenant 冗余，登录全程只访问本库）
// ============================================================

generator client {
  provider = "prisma-client-js"
  // binaryTargets = ["native", "debian-openssl-1.1.x"] // 生产配置与dockerfile 的安装 OpenSSL
  output   = "../../src/prisma/generated/auth"
}

datasource db {
  provider = "mysql"
  url      = env("AUTH_DATABASE_URL")
}

// 用户表（身份）
model SysUser {
  id            Int            @id @default(autoincrement())
  userId        String         @unique @db.VarChar(64)
  username      String         @db.VarChar(128)
  password      String         @db.VarChar(256)
  email         String?        @db.VarChar(128)
  mobilephone   String?        @db.VarChar(32)
  companyName   String?        @db.VarChar(256)
  companyCode   String?        @db.VarChar(64)
  netuserId     String?        @db.VarChar(64)
  userType      String?        @db.VarChar(32)
  prvId         String?        @db.VarChar(64)
  prvName       String?        @db.VarChar(128)
  regId         String?        @db.VarChar(64)
  regName       String?        @db.VarChar(128)
  status        Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userTenants   SysUserTenant[]
}

// 用户-租户关联表（冗余租户展示字段，使登录接口无需跨库查 SysTenant）
// tenantId 为逻辑外键（字符串），对应 ws_design_db.SysTenant.tenantId
model SysUserTenant {
  id           Int      @id @default(autoincrement())
  userId       Int
  tenantId     String   @db.VarChar(64)
  tenantName   String   @db.VarChar(256)
  tenantCode   String?  @db.VarChar(64)
  prvCode      String?  @db.VarChar(64)
  regFullCode  String?  @db.VarChar(128)
  regFullName  String?  @db.VarChar(256)
  teamFullCode String?  @db.VarChar(128)
  createdAt    DateTime @default(now())
  user         SysUser  @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId])
}
